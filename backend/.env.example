# CAGE backend env — copy to backend/.env and fill in.
#   cp backend/.env.example backend/.env
# Never commit backend/.env (it is gitignored). All values start EMPTY.

# ---------------------------------------------------------------- app
# Set false to skip GPU model warm-up at startup (tests, API-only mode).
PREWARM_MODELS=true
# CORS default is open for local dev; restrict in production, e.g.:
# CORS_ORIGINS=["https://your-domain.com"]

# ------------------------------------------------------------------ db
# Default is the local SQLite file; override for Postgres, etc.
# DATABASE_URL=sqlite:////absolute/path/to/cage.db

# ---------------------------------------------------------------- jobs
# Where uploads, frames, crops and result JSON land. Default: backend/jobs/
# JOBS_DIR=/path/to/jobs

# ------------------------------------------------------- local weights
# Defaults are repo-relative under backend/models/ — override as needed.
# YOLO_MODEL_PATH=/path/to/last.pt
# SAM_MODEL_PATH=/path/to/sam3.pt
# POSE_MODEL_PATH=/path/to/yolo26l-pose.pt
# POSTURE_CUDA_DEVICE=cuda:1

# --------------------------------------------- segmentation (stage 2)
# local = SAM weights on GPU | meta = SAM 3.1 over the Meta Model API
SAM_BACKEND=local
# META_MODEL_API_SAM_MODEL=sam-3.1
# META_SAM_MAX_FRAMES=8

# ------------------------------------------------- VLM backend (stage 3)
# local = Qwen3-VL weights on GPU | meta = Meta Model API vision model
VLM_BACKEND=local
# VLM_MODEL_ID=/path/to/qwen3-vl
# VLM_ADAPTER_PATH=/path/to/adapter1
# VLM_GPU_ID=1
# VLM_MAX_PIXELS=100352
# VLM_MAX_NEW_TOKENS=1024
# VLM_MAX_NEW_TOKENS_PASS1=768
# VLM_MAX_NEW_TOKENS_PASS2=1024
# VLM_MAX_ANNOTATED_FRAMES=15
# VLM_VIDEO_FPS=1.0
# VLM_MAX_HAZARD_FRAMES=40
# VLM_CHUNK_SECONDS=60
# VLM_CHUNK_FRAMES=0

# ------------------------------------------- Meta Model API (api.meta.ai)
# PASTE YOUR KEY HERE (in backend/.env — this example file stays empty).
# Powers SAM_BACKEND=meta, VLM_BACKEND=meta, /meta/*, and shift briefs.
# Older names META_MODEL_API_KEY / META_LLAMA_API_KEY / LLAMA_API_KEY
# are also accepted.
MODEL_API_KEY=
# META_MODEL_API_BASE_URL=https://api.meta.ai/v1
# Vision + text default is muse-spark-1.3 (verified live on api.meta.ai).
# META_MODEL_API_VISION_MODEL=muse-spark-1.3
# META_MODEL_API_TEXT_MODEL=muse-spark-1.3
# META_MODEL_API_TIMEOUT_S=120
